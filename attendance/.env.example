# Postgres connection string (Neon on Vercel, or any Postgres).
DATABASE_URL=

# Origin phones will open, WITHOUT the /attendance suffix — the app adds its
# own base path. Production: https://www.boilerblockchain.org
# Local dev: leave unset so QR links fall back to the request host (use your
# LAN IP, e.g. http://192.168.1.20:3000, not localhost, so phones can reach it).
NEXT_PUBLIC_APP_URL=

# Stable HMAC key for officer session cookies. Without it the app derives one
# from DATABASE_URL, which rotates every time the database URL changes.
OFFICER_SESSION_SECRET=

# Chain the check-in signature is scoped to. Nothing is written on-chain.
CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Token lifetimes (seconds). Defaults shown.
SESSION_TOKEN_TTL_SECONDS=240
CHALLENGE_TTL_SECONDS=300
