# Flags are minted per instance and signed, so there are no static flags to keep
# here any more. This one secret is shared by the instancer and the submissions
# Worker; the Worker verifies flags it has never seen by checking the signature.
#
#   openssl rand -hex 32                     -> the value below
#   wrangler secret put FLAG_SECRET          -> same value, in worker/
#
# Keep this file private (gitignored). Rotating the secret invalidates every
# flag already claimed, so rotate between cohorts, not mid-run.
FLAG_SECRET=REPLACE_ME
